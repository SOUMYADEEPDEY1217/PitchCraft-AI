# GEMINI_API_KEY: Optional for Gemini AI generation
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PitchCraft AI Backend Configuration
# Set this to your Python FastAPI backend address (e.g. http://localhost:8000 or production URL)
# If unreachable, PitchCraft AI runs in a clearly-labeled interactive Demo / Local Studio mode
VITE_API_URL="http://localhost:8000"

# Ollama Local LLM Server URL (default: http://localhost:11434)
VITE_OLLAMA_URL="http://localhost:11434"
