# Environment mode: development, staging, production
ENVIRONMENT=development
DEBUG=True

# Application metadata
APP_NAME=PitchCraft AI Backend
APP_VERSION=1.0.0
API_PREFIX=/api

# Server settings
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database settings
# Default SQLite database for local single-user mode:
DATABASE_URL=sqlite:///./pitchcraft.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/pitchcraft_db

# Local Ollama LLM Configuration (qwen3:4b open-weights)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
OLLAMA_TIMEOUT_SECONDS=120

# Security Note (MVP Single-User Mode):
# For local MVP development, authentication is bypassed in single-user mode.
# In a multi-tenant public environment, configure JWT_SECRET_KEY and OAuth2 provider.
SINGLE_USER_MODE=True
